{
  "name": "sessioniq-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply sessioniq --local",
    "migrate:remote": "wrangler d1 migrations apply sessioniq --remote",
    "test": "node test/smoke.mjs",
    "update-keys": "node scripts/update-keys.mjs",
    "setup-test-key": "node scripts/setup-test-key.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260722.1": true
  }
}
